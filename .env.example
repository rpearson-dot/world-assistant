# scripts/setup.sh writes this file for you by asking questions. Or copy it to .env and adjust.
# Keys and passwords do NOT go here; they live in WA_SECRETS_DIR, one per file (scripts/init-secrets.sh).

# Where the database, backups and keys live. Relative paths are inside this folder.
WA_DATA_DIR=./data
WA_SECRETS_DIR=./secrets
# On Unraid, keep them in appdata on the cache pool (an SSD) instead:
# WA_DATA_DIR=/mnt/user/appdata/world-assistant
# WA_SECRETS_DIR=/mnt/user/appdata/world-assistant/secrets

# Extra compose files: the bundled MQTT broker, routing, a key vault (each file says what it adds).
# COMPOSE_FILE=docker-compose.yml:docker-compose.mqtt.yml:docker-compose.routing.yml

# Key vault (optional). By default every secret is a file in WA_SECRETS_DIR. To read them from a vault
# instead, see docs/secrets.md (add docker-compose.vault.yml to COMPOSE_FILE). Files remain the fallback.
# WA_SECRETS_BACKEND=vault          # files (default) | vault | command
# WA_VAULT_ADDR=https://vault.example.lan:8200
# WA_VAULT_MOUNT=secret
# WA_VAULT_PATH=world-assistant
# WA_SECRETS_COMMAND=op read op://Home/world-assistant/{name}

# How many backups to keep (status page, scripts/deploy.sh). They live in WA_DATA_DIR/backups.
# WA_BACKUP_KEEP=14

# Host port for the API when reaching it directly (no Traefik)
WA_API_PORT=8010

# Redis runs in this stack, password protected (secret redis_password). Leave WA_REDIS_URL unset.
# Only set it to use a different Redis; a password in the URL wins over the secret.
# WA_REDIS_URL=redis://192.168.1.10:6379/0
# Home Assistant (optional). The MQTT broker Home Assistant uses:
#   empty          nothing is published (no Home Assistant)
#   192.168.1.10   your broker (Home Assistant's Mosquitto add-on, or a container). Use an IP: container
#                  names do not resolve across Docker networks (Unraid's default bridge, for example)
#   wa-mqtt        the bundled broker: add docker-compose.mqtt.yml to COMPOSE_FILE, and set WA_MQTT_USER=wa
# The password is the mqtt_password secret (generated for the bundled broker).
WA_MQTT_HOST=
WA_MQTT_PORT=1883
WA_MQTT_USER=
# The bundled broker's port on this server, for Home Assistant to connect to.
# WA_MQTT_PUBLISH_PORT=1883

# From the home network the web pages and API need no token; from anywhere else they do. See docs/security.md.
# WA_LOCAL_NO_TOKEN=true
# Host names (comma separated) that count as home ones, beyond IPs, single names (nas) and .lan/.local/.home.
# WA_LOCAL_HOSTS=
# Home Assistant sensors (fuel, trains, roads, pollen, events). See docs/home-assistant.md.
# WA_HA_PUBLISH=true
# WA_HA_INTERVAL_MIN=5

# Only used with docker-compose.traefik.yml
WA_HOST=world-assistant.lan
INFRA_NETWORK=proxynet
TRAEFIK_ENTRYPOINT=websecure

WA_LOG_LEVEL=INFO
TZ=Europe/London

# National Highways raw-response capture. Compose already defaults these, so
# you only need to uncomment a line to change it.
# Every 20 minutes the worker stores raw responses in Postgres so we can see
# real payloads. Set to false to stop calling the API; rows expire after 3 days.
# WA_NH_CAPTURE_ENABLED=true
# WA_NH_CAPTURE_RETENTION_DAYS=3
# Calls allowed per minute across all processes (the API limit is 10 per key).
# WA_NH_RATE_LIMIT_PER_MINUTE=8
# Digital VMS bounding box: lower-left lat,lon then upper-right lat,lon (WGS84).
# WA_NH_VMS_BBOX=51.20,-2.05,52.60,-0.30

# Live polling of closures, speed limits and signs into Postgres (see README).
# WA_NH_POLL_ENABLED=true
# Minutes between live polls (closures, speed limits, signs) and hours between planned-works pulls.
# WA_NH_LIVE_INTERVAL_MIN=10
# WA_NH_PLANNED_INTERVAL_HOURS=2
# How far ahead to fetch planned works, and a cap on pages per planned call.
# WA_NH_PLANNED_DAYS=14
# WA_NH_PLANNED_MAX_PAGES=40

# Fuel Finder prices (needs the fuel_finder_* secrets). Stations are pulled daily at 03:20.
# WA_FUEL_POLL_ENABLED=true
# WA_FUEL_PRICE_INTERVAL_MIN=30

# Ordnance Survey Code-Point Open postcodes (no key needed): about 25 MB, refreshed monthly.
# WA_CODEPOINT_POLL_ENABLED=true
# Ordnance Survey boundaries (which council or region a place is in), a large download:
# WA_BOUNDARY_POLL_ENABLED=true
# WA_BOUNDARY_KINDS=region,county,district   # add ward,parish,constituency for much more detail (and size)
# TfL stations: layout, facilities and lifts out of service (London). On by default; false turns it off.
# WA_TFL_STATIONS_POLL_ENABLED=true
# UK Power Networks: power cuts, street works and local carbon intensity. On by default (reads nothing unless
# a saved place is on their network); false turns it off.
# WA_UKPN_POLL_ENABLED=true
# Bus disruptions from BODS (only some authorities publish; see docs/bus-disruptions.md). Off by default.
# WA_BUS_DISRUPTIONS_POLL_ENABLED=true
# WA_BUS_DISRUPTIONS_KM=25
# Modules from outside the image (comma-separated import strings, package.module:NAME); see docs/modules.md
# WA_EXTRA_MODULES=
# Transport for West Midlands: HTTPS by default; set this only to use the plain-http address the portal lists
# WA_TFWM_BASE_URL=
# Street numbers (USRN), a million and more streets: off unless you want them (for roadworks from Street Manager)
# WA_USRN_POLL_ENABLED=false

# Energy rates (Octopus). Put your API key in the octopus_api_key secret and your account number here,
# or set the tariff code directly (no key needed).
# WA_ENERGY_POLL_ENABLED=true
# WA_OCTOPUS_ACCOUNT=A-1234ABCD
# WA_OCTOPUS_TARIFF=E-1R-COSY-22-12-08-A
# Free Electricity sessions are asked for per import meter; found from the account unless you set it here
# WA_OCTOPUS_MPAN=

# Environment Agency flood warnings (no key needed): every 15 minutes.
# WA_FLOOD_POLL_ENABLED=true

# NaPTAN stop register (no key needed): about 100 MB, refreshed weekly (checked daily at 02:50).
# WA_NAPTAN_POLL_ENABLED=true
# Bundled OpenBao image tag (see docs/openbao.md)
# OPENBAO_VERSION=2.6.4
