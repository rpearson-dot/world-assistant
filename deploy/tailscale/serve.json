{
  "TCP": {
    "443": { "HTTPS": true },
    "8443": { "HTTPS": true },
    "5514": { "TCPForward": "wa-syslog:5514" }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": { "/": { "Proxy": "http://wa-proxy:8000" } }
    },
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": { "/": { "Proxy": "http://ntfy:80" } }
    }
  },
  "AllowFunnel": { "${TS_CERT_DOMAIN}:443": false, "${TS_CERT_DOMAIN}:8443": false }
}
